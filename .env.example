# Scaffold builds without credentials. M2 auth requires the first two values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
# Only set to production for the approved live release, never for staging.
APP_ENV=development
# Later milestones only; never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_LIMIT=0
